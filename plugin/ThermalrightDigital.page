<p class="td-subheading">Categories that follow temperature</p>
<p class="td-help">Select only “Temperature” to make digits such as 42 °C change color. Other categories keep their fixed colors below.</p>
<div class="td-checks" role="group" aria-label="Categories with dynamic colors">
<label for="td-rgb-temperature-zone-temperature"><input id="td-rgb-temperature-zone-temperature" type="checkbox" checked> Temperature</label>
<label for="td-rgb-temperature-zone-load"><input id="td-rgb-temperature-zone-load" type="checkbox" checked> Load</label>
<label for="td-rgb-temperature-zone-power"><input id="td-rgb-temperature-zone-power" type="checkbox" checked> Watts</label>
<label for="td-rgb-temperature-zone-frequency"><input id="td-rgb-temperature-zone-frequency" type="checkbox" checked> MHz</label>
<label for="td-rgb-temperature-zone-decoration"><input id="td-rgb-temperature-zone-decoration" type="checkbox" checked> Decorations</label>
</div>
<div class="td-inline"><button type="button" id="td-temperature-only">Temperature only</button><span class="td-help" id="td-rgb-temperature-summary"></span></div>
<div class="td-palette">
<div class="td-palette-item"><label for="td-rgb-temperature-color-0">Cold color</label><input id="td-rgb-temperature-color-0" type="color" value="#00b4ff"><p class="td-help">Below the thresholds</p></div>
<div class="td-palette-item"><label for="td-rgb-threshold-0">First threshold</label><div class="td-inline"><input id="td-rgb-threshold-0" type="number" min="0" max="125" step="any" value="40" required><span>°C</span><input id="td-rgb-temperature-color-1" type="color" value="#00ff00" aria-label="Color at the first threshold"></div></div>
<div class="td-palette-item"><label for="td-rgb-threshold-1">Second threshold</label><div class="td-inline"><input id="td-rgb-threshold-1" type="number" min="0" max="125" step="any" value="60" required><span>°C</span><input id="td-rgb-temperature-color-2" type="color" value="#ff9900" aria-label="Color at the second threshold"></div></div>
<div class="td-palette-item"><label for="td-rgb-threshold-2">Third threshold</label><div class="td-inline"><input id="td-rgb-threshold-2" type="number" min="0" max="125" step="any" value="80" required><span>°C</span><input id="td-rgb-temperature-color-3" type="color" value="#ff0000" aria-label="Color at and above the third threshold"></div></div>
</div>
<div class="td-inline"><label for="td-rgb-smoothing">Color smoothing</label><input id="td-rgb-smoothing" type="number" min="0" max="30" step="any" value="3" required><span>seconds</span></div>
<p class="td-help">Use increasing thresholds for smooth color transitions. Smoothing affects colors only; digits show the actual reading. The fallback color is used when temperature is unavailable.</p>
</div>
<div id="td-rgb-zones" class="td-subsection" hidden>
<p class="td-subheading" id="td-rgb-zones-heading">Fixed colors by category</p>
<div class="td-zone-grid">
<div class="td-zone"><label for="td-rgb-zone-temperature">Temperature</label><input id="td-rgb-zone-temperature" type="color" value="#00b4ff"><span id="td-rgb-zone-note-temperature" class="td-zone-note">Fixed color</span></div>
<div class="td-zone"><label for="td-rgb-zone-load">Load</label><input id="td-rgb-zone-load" type="color" value="#00b4ff"><span id="td-rgb-zone-note-load" class="td-zone-note">Fixed color</span></div>
<div class="td-zone"><label for="td-rgb-zone-power">Watts</label><input id="td-rgb-zone-power" type="color" value="#00b4ff"><span id="td-rgb-zone-note-power" class="td-zone-note">Fixed color</span></div>
<div class="td-zone"><label for="td-rgb-zone-frequency">MHz</label><input id="td-rgb-zone-frequency" type="color" value="#00b4ff"><span id="td-rgb-zone-note-frequency" class="td-zone-note">Fixed color</span></div>
<div class="td-zone"><label for="td-rgb-zone-decoration">Decorations</label><input id="td-rgb-zone-decoration" type="color" value="#00b4ff"><span id="td-rgb-zone-note-decoration" class="td-zone-note">Fixed color</span></div>
</div>
</div>
<p id="td-rgb-capabilities" class="td-help">Available categories depend on the detected display model.</p>
<div class="td-subsection"><button type="button" id="td-display-test">Test colors and segments</button><p id="td-test-state" class="td-help">An 8-second visual sequence, then an automatic return to normal display. Test digits are synthetic. The test uses saved settings; unsaved changes are kept as a draft.</p></div>
</fieldset>
<div class="td-actions td-footer"><button type="submit">Save</button><button type="button" id="td-diagnostic">Export diagnostics</button></div>
</form>
<p class="td-help">Unavailable values stay blank on the display. “Frames sent” confirms USB transfers; check the physical display to verify rendering.</p>
<div id="td-legacy" hidden><p>A legacy thermalright-screen installation was detected. Its resources are preserved.</p><button type="button" id="td-migrate">Migration: stop the labeled legacy container</button><p>This stops thermalright-screen only if its trcc.setup label matches. Its image, directory and Docker autostart setting are preserved. Disable its autostart in the Docker tab before enabling plugin autostart.</p></div>
<details class="td-details"><summary>Recent logs</summary><pre id="td-logs" style="white-space:pre-wrap;max-height:320px;overflow:auto"></pre></details>
</div>
<script>
(() => {
  const endpoint='/plugins/thermalright-digital/api.php';
  const el=id=>document.getElementById('td-'+id);
  const csrf=document.querySelector('#td-form input[name=csrf_token]').value;
  const zones=['temperature','load','power','frequency','decoration'];
  const zoneLabels={temperature:'temperature',load:'load',power:'watts',frequency:'MHz',decoration:'decorations'};
  const rgbDefaults={mode:'static',color:'#00b4ff',brightness:100,period:6,target:'all',thresholds:[40,60,80],temperature_colors:['#00b4ff','#00ff00','#ff9900','#ff0000'],temperature_zones:[...zones],smoothing:3,zone_colors:Object.fromEntries(zones.map(z=>[z,'#00b4ff']))};
  let loaded=false, busy=false, fetching=false;
  const metric=(value,digits,unit)=>Number.isFinite(value)?`${value.toFixed(digits)} ${unit}`:'Unavailable';
  function rgbVisibility() {
    const mode=el('rgb-mode').value;
    el('rgb-fixed').hidden=!['static','breathing','temperature'].includes(mode);
    el('rgb-animation').hidden=!['breathing','rainbow'].includes(mode);
    el('rgb-temperature').hidden=mode!=='temperature';
    el('rgb-zones').hidden=!['zones','temperature'].includes(mode);
    el('rgb-color-label').textContent=mode==='temperature'?'Fallback color':'Color';
    el('rgb-brightness-value').textContent=`${el('rgb-brightness').value} %`;
    const active=zones.filter(z=>el(`rgb-temperature-zone-${z}`).checked && (el('rgb-target').value==='all' || (el('rgb-target').value==='decoration')===(z==='decoration')));
    el('rgb-temperature-summary').textContent=active.length?`Gradient active on: ${active.map(z=>zoneLabels[z]).join(', ')}.`:'No categories within the selected scope.';
    for (const z of zones) {
      const dynamic=mode==='temperature' && active.includes(z);
      el(`rgb-zone-${z}`).disabled=dynamic;
      el(`rgb-zone-note-${z}`).textContent=dynamic?'Temperature gradient':'Fixed color';
    }
  }
  function settingsFromForm() {
    return {
      autostart:el('auto').checked,interval:Number(el('interval').value),sensor:el('sensor').value,
      frequency_mode:el('frequency-mode').value,power_sensor:el('power-sensor').value,
      rgb:{mode:el('rgb-mode').value,color:el('rgb-color').value,brightness:Number(el('rgb-brightness').value),period:Number(el('rgb-period').value),target:el('rgb-target').value,
        thresholds:[0,1,2].map(i=>Number(el(`rgb-threshold-${i}`).value)),temperature_colors:[0,1,2,3].map(i=>el(`rgb-temperature-color-${i}`).value),temperature_zones:zones.filter(z=>el(`rgb-temperature-zone-${z}`).checked),smoothing:Number(el('rgb-smoothing').value),
        zone_colors:Object.fromEntries(zones.map(z=>[z,el(`rgb-zone-${z}`).value]))}
    };
  }
  async function api(action, data={}) {
    const body=new URLSearchParams({csrf_token:csrf,action,...data});
    const response=await fetch(endpoint,{method:'POST',credentials:'same-origin',headers:{'X-Thermalright-CSRF-Token':csrf},body});
    const text=await response.text();
    if (response.redirected && /\/login(?:\.php)?(?:[/?#]|$)/.test(response.url||'')) throw new Error('Unraid session expired: sign in again and reload this page.');
    if (!text.trim()) throw new Error(`Empty server response (HTTP ${response.status}). Check the server PHP log.`);
    let result;
    try { result=JSON.parse(text); }
    catch (_) { throw new Error(`Invalid JSON response from the server (HTTP ${response.status}). Check the server PHP log.`); }
    if (!result || typeof result!=='object' || Array.isArray(result)) throw new Error(`Unexpected JSON response from the server (HTTP ${response.status}).`);
    if (!response.ok || result.error) throw new Error(result.error || 'Request rejected');
    return result;
  }
  async function refresh() {
    if (busy || fetching) return;
    fetching=true;
    try {
      const s=await api('status');
      el('version').textContent=`Unraid ${s.unraid} / ${s.release}`;
      el('usb').textContent=s.usb.length?s.usb.map(u=>`${u.id} — ${u.node} — port ${u.port}`).join(', '):'Not found';
      const backend=s.backend||{}, metrics=s.metrics||{}, settings=s.settings;
      const fresh=backend.timestamp && Date.now()/1000-backend.timestamp<Math.max(10,settings.interval*2+2);
      el('backend').textContent=!s.docker?'Docker unavailable':(s.supervisor && fresh && backend.ready?`Frames sent — ${backend.model||'display connected'}`:(s.supervisor?'Waiting / connecting':'Stopped'));
      el('temp').textContent=metric(metrics.cpu_temp,1,'°C');
      el('temp-source').textContent=metrics.sensor||'';
      el('load').textContent=metric(metrics.cpu_load,1,'%');
      const frequencyKind=metrics.frequency_kind==='requested'?'driver-requested frequency':(metrics.frequency_kind==='measured'?'measured frequency':'');
      const frequencyMode=(metrics.frequency_mode||settings.frequency_mode)==='average'?'average CPU policy frequency':'maximum CPU policy frequency';
      el('frequency').textContent=metric(metrics.cpu_mhz,0,'MHz');
      el('frequency-summary').textContent=Number.isFinite(metrics.cpu_mhz)?`${frequencyMode==='average CPU policy frequency'?'Average':'Maximum'}${frequencyKind?' · '+frequencyKind:''}`:'';
      el('frequency-source').textContent=metrics.frequency_source||'Unavailable';
      el('power').textContent=metric(metrics.cpu_watts,1,'W');
      el('power-source').textContent=metrics.power_source||'';
      const caps=backend.capabilities;
      el('capabilities').textContent=caps && typeof caps.power==='boolean' && typeof caps.frequency==='boolean'
        ? `Watts : ${caps.power?'supported':'unsupported'} ; MHz : ${caps.frequency?'supported':'unsupported'}. Host metrics remain visible here.`
        : 'Display capabilities will be confirmed after connecting. The readings above come from the host.';
      el('rgb-capabilities').textContent=caps && typeof caps.zones==='boolean'
        ? (caps.zones?`Zone colors available${Array.isArray(caps.zone_names)&&caps.zone_names.length?' : '+caps.zone_names.map(z=>zoneLabels[z]||z).join(', '):''}.`:'This profile does not support independent zone colors.')+(caps.decoration===false?' Decorations cannot be controlled with this profile.':'')
        : 'Available zones depend on the detected display model.';
      el('test-state').textContent=backend.test_active
        ? 'Visual test running: synthetic digits on the display, automatic return after 8 seconds. Host readings above remain real.'
        : 'An 8-second visual sequence, then an automatic return to normal display. Test digits are synthetic. The test uses saved settings; unsaved changes are kept as a draft.';
      el('message').textContent=s.pending?'Uninstall incomplete: enable Docker and retry from Plugins.':(s.service.message||`Ready. Autostart ${settings.autostart?'enabled':'disabled'}.`);
      if (!loaded) {
        el('auto').checked=settings.autostart; el('interval').value=settings.interval;
        for (const v of s.sensors) el('sensor').add(new Option(`${v.label} (${v.value===null?'unavailable':v.value+' °C'})`,v.id));
        if (![...el('sensor').options].some(o=>o.value===settings.sensor)) el('sensor').add(new Option('Configured sensor missing',settings.sensor));
        el('sensor').value=settings.sensor;
        el('frequency-mode').value=settings.frequency_mode||'max';
        const powerSources=(s.metric_sources||{}).power||[];
        for (const v of powerSources) el('power-sensor').add(new Option(`${v.label}${v.available===false?' — unavailable':''}`,v.id));
        const powerSensor=settings.power_sensor||'auto';
        if (![...el('power-sensor').options].some(o=>o.value===powerSensor)) el('power-sensor').add(new Option('Configured source missing',powerSensor));
        el('power-sensor').value=powerSensor;
        const rgb={...rgbDefaults,...(settings.rgb||{})};
        for (const key of ['mode','color','brightness','period','target','smoothing']) el(`rgb-${key}`).value=rgb[key];
        for (let i=0;i<3;i++) el(`rgb-threshold-${i}`).value=rgb.thresholds[i];
        for (let i=0;i<4;i++) el(`rgb-temperature-color-${i}`).value=rgb.temperature_colors[i];
        for (const z of zones) el(`rgb-temperature-zone-${z}`).checked=rgb.temperature_zones.includes(z);
        for (const z of zones) el(`rgb-zone-${z}`).value=(rgb.zone_colors||{})[z]||rgbDefaults.zone_colors[z];
        rgbVisibility(); loaded=true;
      }
      const legacy=s.legacy;
      el('legacy').hidden=!(legacy.appdata||legacy.container||legacy.image||(legacy.labelled_containers||[]).length);
      el('logs').textContent=(await api('logs')).logs;
      return true;
    } catch(e) { el('message').textContent=e.message; return false; }
    finally { fetching=false; }
  }
  async function act(action,data={}) {
    if (busy) return;
    busy=true;
    document.querySelectorAll('#td-form button').forEach(b=>b.disabled=true);
    let message, failed=false;
    try { const r=await api(action,data); message=r.message||'Operation completed'; }
    catch(e) { message=e.message; failed=true; }
    finally { busy=false; document.querySelectorAll('#td-form button').forEach(b=>b.disabled=false); const refreshed=await refresh(); if (message && (failed || refreshed)) el('message').textContent=message; }
  }
  el('form').addEventListener('submit',e=>{
    e.preventDefault();
    const settings=settingsFromForm();
    if (!settings.rgb.temperature_zones.length) { el('message').textContent='Select at least one category for temperature colors.'; return; }
    act('settings',{settings:JSON.stringify(settings)});
  });
  el('rgb-mode').addEventListener('change',rgbVisibility);
  el('rgb-target').addEventListener('change',rgbVisibility);
  el('rgb-brightness').addEventListener('input',rgbVisibility);
  for (const z of zones) el(`rgb-temperature-zone-${z}`).addEventListener('change',rgbVisibility);
  el('temperature-only').addEventListener('click',()=>{
    for (const z of zones) el(`rgb-temperature-zone-${z}`).checked=z==='temperature';
    el('rgb-target').value='all';
    rgbVisibility();
  });
  el('display-test').addEventListener('click',()=>act('display-test'));
  document.querySelectorAll('[data-action]').forEach(b=>b.addEventListener('click',()=>act(b.dataset.action)));
  el('migrate').addEventListener('click',()=>{if(confirm('Stop only the legacy thermalright-screen container with the expected label?')) act('legacy-stop');});
  el('diagnostic').addEventListener('click',async()=>{
    try {const d=await api('diagnostic');const a=document.createElement('a');const url=URL.createObjectURL(new Blob([JSON.stringify(d,null,2)],{type:'application/json'}));a.href=url;a.download='thermalright-diagnostic.json';a.click();setTimeout(()=>URL.revokeObjectURL(url),1000);}catch(e){el('message').textContent=e.message;}
  });
  refresh();setInterval(()=>{if(!document.hidden)refresh();},5000);
})();
</script>
