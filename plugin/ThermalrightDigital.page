<script>
(() => {
  const i18n=JSON.parse(document.getElementById('td-i18n').textContent);
  const clockValue=value=>i18n.direction==='rtl'?'\u2066'+value+'\u2069':value;
  const t=(source,parameters={})=>(i18n.messages[source]||source).replace(/\{([A-Za-z0-9_]+)\}/g,(match,key)=>Object.prototype.hasOwnProperty.call(parameters,key)?String(parameters[key]):match);
  const list=values=>values.join(i18n.locale==='ar_AR'?'، ':['zh_CN','zh_TW','ja_JA'].includes(i18n.locale)?'、':', ');
  const serverMessage=message=>{
    const text=String(message);
    if (/^(missing|wrong|uninitialized) csrf_token$/.test(text)) return t('Invalid CSRF token');
    const fatal=text.match(/^Internal PHP error in (.+)\. Check the server PHP log\.$/);
    return fatal?t('Internal PHP error in {location}. Check the server PHP log.',{location:fatal[1]}):t(text);
  };
  const endpoint='/plugins/thermalright-digital/api.php';
  const el=id=>document.getElementById('td-'+id);
  const csrf=document.querySelector('#td-form input[name=csrf_token]').value;
  const zones=['temperature','load','power','frequency','decoration'];
  const weekdays=[1,2,3,4,5,6,7];
  const quietDefaults={enabled:false,days:[...weekdays],all_day:false,start:'23:00',end:'07:00'};
  const zoneLabels={temperature:t('temperature'),load:t('load'),power:t('watts'),frequency:'MHz',decoration:t('decorations')};
  const rgbDefaults={mode:'static',color:'#00b4ff',brightness:100,period:6,target:'all',thresholds:[40,60,80],temperature_colors:['#00b4ff','#00ff00','#ff9900','#ff0000'],temperature_zones:[...zones],smoothing:3,zone_colors:Object.fromEntries(zones.map(z=>[z,'#00b4ff']))};
  let loaded=false, busy=false, fetching=false;
  function quietVisibility() {
    const enabled=el('quiet-enabled').checked, allDay=el('quiet-all-day').checked;
    el('quiet-options').hidden=!enabled;
    el('quiet-times').hidden=allDay;
    for (const key of ['start','end']) el(`quiet-${key}`).disabled=!enabled || allDay;
  }
  const metric=(value,digits,unit)=>Number.isFinite(value)?`${value.toFixed(digits)} ${unit}`:t('Unavailable');
  function rgbVisibility() {
    const mode=el('rgb-mode').value;
    el('rgb-fixed').hidden=!['static','breathing','temperature'].includes(mode);
    el('rgb-animation').hidden=!['breathing','rainbow'].includes(mode);
    el('rgb-temperature').hidden=mode!=='temperature';
    el('rgb-zones').hidden=!['zones','temperature'].includes(mode);
    el('rgb-color-label').textContent=mode==='temperature'?t('Fallback color'):t('Color');
    el('rgb-brightness-value').textContent=`${el('rgb-brightness').value} %`;
    const active=zones.filter(z=>el(`rgb-temperature-zone-${z}`).checked && (el('rgb-target').value==='all' || (el('rgb-target').value==='decoration')===(z==='decoration')));
    el('rgb-temperature-summary').textContent=active.length?t('Gradient active on: {zones}.',{zones:list(active.map(z=>zoneLabels[z]))}):t('No categories within the selected scope.');
    for (const z of zones) {
      const dynamic=mode==='temperature' && active.includes(z);
      el(`rgb-zone-${z}`).disabled=dynamic;
      el(`rgb-zone-note-${z}`).textContent=dynamic?t('Temperature gradient'):t('Fixed color');
    }
  }
  function settingsFromForm() {
    return {
      autostart:el('auto').checked,interval:Number(el('interval').value),sensor:el('sensor').value,
      frequency_mode:el('frequency-mode').value,power_sensor:el('power-sensor').value,
      quiet_hours:{enabled:el('quiet-enabled').checked,days:weekdays.filter(d=>el(`quiet-day-${d}`).checked),all_day:el('quiet-all-day').checked,start:el('quiet-start').value,end:el('quiet-end').value},
      rgb:{mode:el('rgb-mode').value,color:el('rgb-color').value,brightness:Number(el('rgb-brightness').value),period:Number(el('rgb-period').value),target:el('rgb-target').value,
        thresholds:[0,1,2].map(i=>Number(el(`rgb-threshold-${i}`).value)),temperature_colors:[0,1,2,3].map(i=>el(`rgb-temperature-color-${i}`).value),temperature_zones:zones.filter(z=>el(`rgb-temperature-zone-${z}`).checked),smoothing:Number(el('rgb-smoothing').value),
        zone_colors:Object.fromEntries(zones.map(z=>[z,el(`rgb-zone-${z}`).value]))}
    };
  }
  async function api(action, data={}) {
    const body=new URLSearchParams({csrf_token:csrf,action,...data});
    const response=await fetch(endpoint,{method:'POST',credentials:'same-origin',headers:{'X-Thermalright-CSRF-Token':csrf},body});
    const text=await response.text();
    if (response.redirected && /\/login(?:\.php)?(?:[/?#]|$)/.test(response.url||'')) throw new Error(t('Unraid session expired: sign in again and reload this page.'));
    if (!text.trim()) throw new Error(t('Empty server response (HTTP {status}). Check the server PHP log.',{status:response.status}));
    let result;
    try { result=JSON.parse(text); }
    catch (_) { throw new Error(t('Invalid JSON response from the server (HTTP {status}). Check the server PHP log.',{status:response.status})); }
    if (!result || typeof result!=='object' || Array.isArray(result)) throw new Error(t('Unexpected JSON response from the server (HTTP {status}).',{status:response.status}));
    if (!response.ok || result.error) throw new Error(serverMessage(result.error || 'Request rejected'));
    return result;
  }
  async function refresh() {
    if (busy || fetching) return;
    fetching=true;
    try {
      const s=await api('status');
      el('version').textContent=`Unraid ${s.unraid} / ${s.release} · ${i18n.name}`;
      el('usb').textContent=s.usb.length?s.usb.map(u=>`${u.id} — ${u.node} — port ${u.port}`).join(', '):t('Not found');
      const backend=s.backend||{}, metrics=s.metrics||{}, settings=s.settings;
      const fresh=backend.timestamp && Date.now()/1000-backend.timestamp<Math.max(10,settings.interval*2+2);
      el('backend').textContent=!s.docker?t('Docker unavailable'):(s.supervisor && fresh && backend.ready?(backend.display_off && backend.display_reason==='schedule'?t('Display off — scheduled'):t('Frames sent — {model}',{model:backend.model||t('display connected')})):(s.supervisor?t('Waiting / connecting'):t('Stopped')));
      const display=s.display||{};
      el('quiet-clock').textContent=display.local_time && display.timezone?t('Server time: {time} · {timezone}',{time:clockValue(display.local_time.replace(/^(Mon|Tue|Wed|Thu|Fri|Sat|Sun)\b/,day=>t(day))),timezone:clockValue(display.timezone)}):t('Schedule follows the Unraid server clock.');
      el('quiet-status').textContent=s.supervisor && fresh && backend.ready && typeof backend.display_off==='boolean'
        ? (backend.display_off?(backend.display_reason==='schedule'?t('Display off by schedule. Metrics and USB connection remain active.'):t('Display off: check backend status and logs.')):t('Display on.'))
        : t('Display state will be confirmed when the backend connects.');
      el('temp').textContent=metric(metrics.cpu_temp,1,'°C');
      el('temp-source').textContent=metrics.sensor||'';
      el('load').textContent=metric(metrics.cpu_load,1,'%');
      const frequencyKind=metrics.frequency_kind==='requested'?t('driver-requested frequency'):(metrics.frequency_kind==='measured'?t('measured frequency'):'');
      const frequencyMode=(metrics.frequency_mode||settings.frequency_mode)==='average'?'average CPU policy frequency':'maximum CPU policy frequency';
      el('frequency').textContent=metric(metrics.cpu_mhz,0,'MHz');
      el('frequency-summary').textContent=Number.isFinite(metrics.cpu_mhz)?`${frequencyMode==='average CPU policy frequency'?t('Average'):t('Maximum')}${frequencyKind?' · '+frequencyKind:''}`:'';
      el('frequency-source').textContent=metrics.frequency_source?metrics.frequency_source.replace('maximum of unique active policies',t('maximum of unique active policies')).replace('arithmetic mean of unique active policies',t('arithmetic mean of unique active policies')):t('Unavailable');
      el('power').textContent=metric(metrics.cpu_watts,1,'W');
      el('power-source').textContent=metrics.power_source||'';
      const caps=backend.capabilities;
      el('capabilities').textContent=caps && typeof caps.power==='boolean' && typeof caps.frequency==='boolean'
        ? t('Watts : {power} ; MHz : {frequency}. Host metrics remain visible here.',{power:caps.power?t('supported'):t('unsupported'),frequency:caps.frequency?t('supported'):t('unsupported')})
        : t('Display capabilities will be confirmed after connecting. The readings above come from the host.');
      el('rgb-capabilities').textContent=caps && typeof caps.zones==='boolean'
        ? (caps.zones?t('Zone colors available: {zones}.',{zones:Array.isArray(caps.zone_names)?list(caps.zone_names.map(z=>zoneLabels[z]||z)):''}):t('This profile does not support independent zone colors.'))+(caps.decoration===false?' '+t('Decorations cannot be controlled with this profile.'):'')
        : t('Available zones depend on the detected display model.');
      el('test-state').textContent=backend.test_active
        ? t('Visual test running: synthetic digits on the display, automatic return after 8 seconds. Host readings above remain real.')
        : t('An 8-second visual sequence, then an automatic return to normal display. Test digits are synthetic. The test uses saved settings; unsaved changes are kept as a draft.');
      el('message').textContent=s.pending?t('Uninstall incomplete: enable Docker and retry from Plugins.'):((s.service.message?serverMessage(s.service.message):t('Ready. Autostart {state}.',{state:settings.autostart?t('enabled'):t('disabled')})));
      if (!loaded) {
        const quiet={...quietDefaults,...(settings.quiet_hours||{})};
        el('quiet-enabled').checked=quiet.enabled; el('quiet-all-day').checked=quiet.all_day;
        el('quiet-start').value=quiet.start; el('quiet-end').value=quiet.end;
        for (const day of weekdays) el(`quiet-day-${day}`).checked=quiet.days.includes(day);
        quietVisibility();
        el('auto').checked=settings.autostart; el('interval').value=settings.interval;
        for (const v of s.sensors) el('sensor').add(new Option(`${v.label} (${v.value===null?t('unavailable'):v.value+' °C'})`,v.id));
        if (![...el('sensor').options].some(o=>o.value===settings.sensor)) el('sensor').add(new Option(t('Configured sensor missing'),settings.sensor));
        el('sensor').value=settings.sensor;
        el('frequency-mode').value=settings.frequency_mode||'max';
        const powerSources=(s.metric_sources||{}).power||[];
        for (const v of powerSources) el('power-sensor').add(new Option(`${v.label}${v.available===false?' — '+t('unavailable'):''}`,v.id));
        const powerSensor=settings.power_sensor||'auto';
        if (![...el('power-sensor').options].some(o=>o.value===powerSensor)) el('power-sensor').add(new Option(t('Configured source missing'),powerSensor));
        el('power-sensor').value=powerSensor;
        const rgb={...rgbDefaults,...(settings.rgb||{})};
        for (const key of ['mode','color','brightness','period','target','smoothing']) el(`rgb-${key}`).value=rgb[key];
        for (let i=0;i<3;i++) el(`rgb-threshold-${i}`).value=rgb.thresholds[i];
        for (let i=0;i<4;i++) el(`rgb-temperature-color-${i}`).value=rgb.temperature_colors[i];
        for (const z of zones) el(`rgb-temperature-zone-${z}`).checked=rgb.temperature_zones.includes(z);
        for (const z of zones) el(`rgb-zone-${z}`).value=(rgb.zone_colors||{})[z]||rgbDefaults.zone_colors[z];
        rgbVisibility(); loaded=true;
      }
      const legacy=s.legacy;
      el('legacy').hidden=!(legacy.appdata||legacy.container||legacy.image||(legacy.labelled_containers||[]).length);
      el('logs').textContent=(await api('logs')).logs;
      return true;
    } catch(e) { el('message').textContent=e.message; return false; }
    finally { fetching=false; }
  }
  async function act(action,data={}) {
    if (busy) return;
    busy=true;
    document.querySelectorAll('#td-form button').forEach(b=>b.disabled=true);
    let message, failed=false;
    try { const r=await api(action,data); message=serverMessage(r.message||'Operation completed'); }
    catch(e) { message=e.message; failed=true; }
    finally { busy=false; document.querySelectorAll('#td-form button').forEach(b=>b.disabled=false); const refreshed=await refresh(); if (message && (failed || refreshed)) el('message').textContent=message; }
  }
  el('form').addEventListener('submit',e=>{
    e.preventDefault();
    const settings=settingsFromForm();
    if (settings.quiet_hours.enabled && !settings.quiet_hours.days.length) { el('message').textContent=t('Select at least one day for scheduled display off.'); return; }
    if (settings.quiet_hours.enabled && !settings.quiet_hours.all_day && settings.quiet_hours.start===settings.quiet_hours.end) { el('message').textContent=t('Choose different off/on times, or select entire days.'); return; }
    if (!settings.rgb.temperature_zones.length) { el('message').textContent=t('Select at least one category for temperature colors.'); return; }
    act('settings',{settings:JSON.stringify(settings)});
  });
  el('rgb-mode').addEventListener('change',rgbVisibility);
  el('quiet-enabled').addEventListener('change',quietVisibility);
  el('quiet-all-day').addEventListener('change',quietVisibility);
  el('rgb-target').addEventListener('change',rgbVisibility);
  el('rgb-brightness').addEventListener('input',rgbVisibility);
  for (const z of zones) el(`rgb-temperature-zone-${z}`).addEventListener('change',rgbVisibility);
  el('temperature-only').addEventListener('click',()=>{
    for (const z of zones) el(`rgb-temperature-zone-${z}`).checked=z==='temperature';
    el('rgb-target').value='all';
    rgbVisibility();
  });
  el('display-test').addEventListener('click',()=>act('display-test'));
  document.querySelectorAll('[data-action]').forEach(b=>b.addEventListener('click',()=>act(b.dataset.action)));
  el('migrate').addEventListener('click',()=>{if(confirm(t('Stop only the legacy thermalright-screen container with the expected label?'))) act('legacy-stop');});
  el('diagnostic').addEventListener('click',async()=>{
    try {const d=await api('diagnostic');const a=document.createElement('a');const url=URL.createObjectURL(new Blob([JSON.stringify(d,null,2)],{type:'application/json'}));a.href=url;a.download='thermalright-diagnostic.json';a.click();setTimeout(()=>URL.revokeObjectURL(url),1000);}catch(e){el('message').textContent=e.message;}
  });
  refresh();setInterval(()=>{if(!document.hidden)refresh();},5000);
})();
</script>
