<div class="td-grid">
<div class="td-field"><label for="td-rgb-mode">Mode</label><select id="td-rgb-mode"><option value="static">Fixed color</option><option value="zones">Colors by category</option><option value="temperature">CPU temperature colors</option><option value="breathing">Breathing</option><option value="rainbow">Rainbow</option></select></div>
<div class="td-field"><label for="td-rgb-target">Effect scope</label><select id="td-rgb-target"><option value="all">Digits and decorations</option><option value="digits">Digits</option><option value="decoration">Decorations</option></select></div>
