<div class="td-field" id="td-rgb-animation" hidden><label for="td-rgb-period">Cycle duration</label><div class="td-inline"><input id="td-rgb-period" type="number" min="1" max="60" step="any" value="6" required><span>seconds</span></div></div>
</div>
