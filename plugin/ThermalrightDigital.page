<?php
$tdVar = @parse_ini_file('/var/local/emhttp/var.ini',false,INI_SCANNER_RAW) ?: [];
?>
<div id="td-panel">
<style>
#td-panel { --td-border:rgba(128,128,128,.35); --td-soft:rgba(128,128,128,.08); max-width:1120px; }
#td-panel * { box-sizing:border-box; }
#td-panel .td-overview { display:flex; justify-content:space-between; flex-wrap:wrap; gap:8px 20px; margin-bottom:14px; }
#td-panel .td-device { margin:0 0 4px; font-weight:600; }
#td-panel .td-brand { display:flex; align-items:center; gap:12px; }
#td-panel .td-logo { width:48px; height:48px; flex:none; }
#td-panel .td-help { margin:6px 0; line-height:1.5; font-size:.94em; opacity:.8; }
#td-panel .td-status { display:inline-flex; align-items:center; border:1px solid var(--td-border); border-radius:20px; padding:6px 12px; font-size:.94em; align-self:flex-start; }
#td-panel #td-message { margin:8px 0 16px; min-height:1.5em; line-height:1.5; }
#td-panel .td-metrics { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:12px; margin:0 0 16px; }
#td-panel .td-metric { margin:0; border:1px solid var(--td-border); border-radius:6px; background:var(--td-soft); padding:14px 16px; }
#td-panel .td-metric dt { float:none; width:auto; display:block; margin:0 0 8px; padding:0; text-align:left; font-size:.94em; }
#td-panel .td-metric dd { float:none; width:auto; display:block; margin:0; padding:0; text-align:left; }
#td-panel .td-value { font-size:1.8em; font-weight:600; line-height:1.3; overflow-wrap:anywhere; }
#td-panel .td-metric-source { display:block; font-size:.85em; margin-top:6px; opacity:.75; overflow-wrap:anywhere; min-height:1.4em; }
#td-panel .td-section { margin:18px 0; padding:18px; border:1px solid var(--td-border); border-radius:6px; }
#td-panel .td-section > legend { width:auto; margin:0; padding:0 8px; font-weight:600; font-size:1.05em; }
#td-panel .td-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:14px 24px; }
#td-panel .td-field { min-width:0; }
#td-panel .td-field > label, #td-panel .td-label { display:block; float:none; width:auto; text-align:left; text-align-last:auto; margin:0 0 6px; line-height:1.4; font-weight:600; }
#td-panel label { width:auto; text-align:left; text-align-last:auto; }
#td-panel select { display:block; width:100%; max-width:none; margin:0; }
#td-panel input[type=number] { width:100px; margin:0; }
#td-panel input[type=color] { width:54px; height:34px; padding:2px; vertical-align:middle; margin:0; cursor:pointer; }
#td-panel input[type=color]:disabled { cursor:default; opacity:.55; }
#td-panel input[type=checkbox] { margin:0 6px 0 0; vertical-align:middle; }
#td-panel .td-inline { display:flex; flex-wrap:wrap; align-items:center; gap:8px 12px; }
#td-panel .td-inline > label { display:inline-flex; align-items:center; margin:0; }
#td-panel .td-wide { grid-column:1/-1; }
#td-panel .td-subsection { margin-top:18px; padding-top:16px; border-top:1px solid var(--td-border); }
#td-panel .td-subheading { margin:0 0 8px; font-size:1em; font-weight:600; }
#td-panel .td-checks { display:flex; flex-wrap:wrap; gap:8px 12px; margin:10px 0; }
#td-panel .td-checks label { display:inline-flex; align-items:center; padding:7px 10px; border:1px solid var(--td-border); border-radius:4px; margin:0; }
#td-panel .td-palette { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:10px; margin:14px 0; }
#td-panel .td-palette-item, #td-panel .td-zone { padding:12px; border:1px solid var(--td-border); border-radius:4px; min-width:0; }
#td-panel .td-palette-item label, #td-panel .td-zone label { display:block; width:auto; margin:0 0 8px; font-weight:600; text-align:left; }
#td-panel .td-palette-item .td-inline { gap:8px; }
#td-panel .td-palette-item input[type=number] { width:76px; }
#td-panel .td-zone-grid { display:grid; grid-template-columns:repeat(5,minmax(0,1fr)); gap:10px; }
#td-panel .td-zone-note { display:block; font-size:.82em; opacity:.75; margin-top:7px; }
#td-panel .td-actions { display:flex; flex-wrap:wrap; gap:8px; align-items:center; margin-top:14px; }
#td-panel .td-actions button { margin:0; }
#td-panel button { max-width:100%; white-space:normal; height:auto; line-height:1.5; }
#td-panel .td-details { margin:12px 0; }
#td-panel .td-details summary { cursor:pointer; }
#td-panel .td-detail-grid { display:grid; grid-template-columns:minmax(130px,180px) minmax(0,1fr); gap:8px 16px; margin:12px 0; }
#td-panel .td-detail-grid dt, #td-panel .td-detail-grid dd { float:none; display:block; width:auto; padding:0; margin:0; text-align:left; overflow-wrap:anywhere; }
#td-panel .td-footer { margin-top:16px; padding-top:14px; border-top:1px solid var(--td-border); }
#td-panel [hidden] { display:none !important; }
@media(max-width:800px) { #td-panel .td-metrics { grid-template-columns:repeat(2,minmax(0,1fr)); } #td-panel .td-zone-grid { grid-template-columns:repeat(3,minmax(0,1fr)); } }
@media(max-width:600px) { #td-panel .td-grid { grid-template-columns:1fr; } #td-panel .td-section { padding:12px; } #td-panel .td-palette, #td-panel .td-zone-grid { grid-template-columns:repeat(2,minmax(0,1fr)); } #td-panel .td-detail-grid { grid-template-columns:1fr; gap:4px; } #td-panel .td-detail-grid dd { margin-bottom:8px; } #td-panel .td-value { font-size:1.5em; } }
</style>
<div class="td-overview">
<div class="td-brand"><img class="td-logo" src="/plugins/thermalright-digital/logo.png" alt=""><div><p class="td-device">THERMALRIGHT DIGITAL</p><p class="td-help">Peerless Assassin 140 Digital</p><p class="td-help" id="td-version"></p></div></div>
